# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/app_db

# Alternative format (more readable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_NAME=app_db
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}